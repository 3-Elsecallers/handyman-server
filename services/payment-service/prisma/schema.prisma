generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  pending
  authorized
  paid
  refunded
  partially_refunded
  failed
}

enum PaymentType {
  booking
  tip
}

enum PaymentMethod {
  online
  cash
}

enum RefundStatus {
  pending
  processed
  failed
}

enum PayoutStatus {
  pending
  processed
  failed
  reversed
}

enum PayoutRequestStatus {
  pending
  processing
  processed
  failed
  reversed
}

enum PayoutMedium {
  mobile_money
  bank
}

enum LedgerAccountType {
  collected
  provider_wallet
  platform_fee
  reserve
}

enum LedgerEntryType {
  payment_allocated
  platform_fee
  cash_fee
  hold
  release
  tip
  payout
  refund
  company_withdrawal
  adjustment
}

model Payment {
  id                 String        @id @default(uuid())
  bookingId          String
  customerId         String
  providerId         String?
  providerUserId     String?
  type               PaymentType   @default(booking)
  status             PaymentStatus @default(pending)
  paymentMethod      PaymentMethod @default(online)
  providerConfirmedAt DateTime?
  providerConfirmedById String?
  cashCollectedAt    DateTime?

  amount             Float
  platformFee        Float
  providerEarning    Float
  tipAmount          Float         @default(0)

  paystackRef        String?       @unique
  paystackAccessCode String?
  authorizationUrl   String?

  refundedAmount     Float         @default(0)
  refundReason       String?

  // Who / what workflow initiated this payment transaction, for auditability.
  initiatedById      String?
  initiatedByRole    String?
  initiatedBy        String?

  initiatedAt        DateTime      @default(now())
  authorizedAt       DateTime?
  capturedAt         DateTime?
  failedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  refunds  Refund[]
  payouts  Payout[]

  @@unique([bookingId, type])
  @@index([bookingId])
  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([paystackRef])
  @@index([type])
}

model Refund {
  id                 String       @id @default(uuid())
  paymentId          String
  amount             Float
  reason             String?
  initiatorId        String?
  initiatorRole      String?
  paystackRef        String?
  status             RefundStatus @default(pending)
  createdAt          DateTime     @default(now())
  processedAt        DateTime?
  failedAt           DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model Payout {
  id                String       @id @default(uuid())
  paymentId         String
  providerId        String
  amount            Float
  paystackRef       String?
  transferCode      String?
  status            PayoutStatus @default(pending)
  scheduledAt       DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime     @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([providerId])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  event       String
  reference   String
  payload     Json
  verified    Boolean  @default(true)
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([event, reference])
  @@index([reference])
}

model LedgerAccount {
  id        String            @id @default(uuid())
  type      LedgerAccountType
  ownerId   String?
  currency  String            @default("GHS")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  credits LedgerEntry[] @relation("LedgerCredits")
  debits  LedgerEntry[] @relation("LedgerDebits")

  @@unique([type, ownerId])
  @@index([type])
  @@index([ownerId])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  accountId      String
  counterpartyId String?
  type           LedgerEntryType
  credit         Float           @default(0)
  debit          Float           @default(0)
  currency       String          @default("GHS")
  refType        String?
  refId          String?
  createdAt      DateTime        @default(now())

  account      LedgerAccount? @relation("LedgerCredits", fields: [accountId], references: [id])
  counterparty LedgerAccount? @relation("LedgerDebits", fields: [counterpartyId], references: [id])

  @@unique([refType, refId, type, accountId])
  @@index([accountId])
  @@index([counterpartyId])
  @@index([refType, refId])
  @@index([createdAt])
}

model PayoutMethod {
  id           String        @id @default(uuid())
  providerId   String        @unique
  providerUserId String
  medium       PayoutMedium
  network      String?
  accountName  String?
  accountNumberEncrypted String
  bankCode     String?
  bankName     String?
  recipientCode String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([providerId])
  @@index([isActive])
}

model PayoutRequest {
  id             String              @id @default(uuid())
  providerId     String
  providerUserId String
  medium         PayoutMedium
  amount         Float
  fee            Float               @default(0)
  netAmount      Float
  status         PayoutRequestStatus @default(pending)
  paystackRef    String?
  transferCode   String?
  recipientCode  String?
  initiatedById  String?
  scheduledAt    DateTime?
  paidAt         DateTime?
  failedAt       DateTime?
  reversedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([providerId])
  @@index([providerUserId])
  @@index([status])
  @@index([paystackRef])
}
